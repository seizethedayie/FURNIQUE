# TiDB Cloud Starter / MySQL online
DB_HOST=ISI_HOST_DATABASE
DB_PORT=4000
DB_USER=ISI_USERNAME_DATABASE
DB_PASSWORD=ISI_PASSWORD_DATABASE
DB_NAME=test
DB_SSL=true
DB_CONNECTION_LIMIT=5

# Cloudinary (penyimpanan permanen bukti pembayaran dan gambar custom)
CLOUDINARY_CLOUD_NAME=ISI_CLOUD_NAME
CLOUDINARY_API_KEY=ISI_API_KEY
CLOUDINARY_API_SECRET=ISI_API_SECRET

# Buat nilai acak panjang, minimal 32 karakter
SESSION_SECRET=GANTI_DENGAN_SECRET_ACAK_PANJANG
NODE_ENV=production
